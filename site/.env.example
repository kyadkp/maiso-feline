# Base de données (SQLite en local, PostgreSQL à la mise en ligne — étape 7)
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions (Auth.js) — générer une vraie valeur aléatoire
# avant la mise en ligne, par exemple avec : openssl rand -base64 32
AUTH_SECRET="change-me"

# Compte admin créé par `npx prisma db seed` (à changer avant la mise en ligne)
ADMIN_PHONE="770000000"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Gérante"
