generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CLIENT
  ADMIN
}

model User {
  id                 String    @id @default(cuid())
  phone              String    @unique
  name               String
  passwordHash       String
  role               Role      @default(CLIENT)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  orders             Order[]
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  COD
}

enum OrderStatus {
  NOUVELLE
  CONFIRMEE
  LIVREE
  ANNULEE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  user          User?         @relation(fields: [userId], references: [id])
  userId        String?
  customerName  String
  phone         String
  address       String
  city          String
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paytechToken  String?
  status        OrderStatus   @default(NOUVELLE)
  totalAmount   Int
  createdAt     DateTime      @default(now())
  items         OrderItem[]

  @@index([phone])
  @@index([userId])
}

model OrderItem {
  id       String @id @default(cuid())
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  slug     String
  name     String
  price    Int
  color    String
  size     String
  quantity Int
}

enum Section {
  FEMME
  HOMME
  CHAUSSURES
}

model Category {
  id       String    @id @default(cuid())
  section  Section
  slug     String
  label    String
  products Product[]

  @@unique([section, slug])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  section       Section
  category      Category @relation(fields: [categoryId], references: [id])
  categoryId    String
  price         Int
  oldPrice      Int?
  description   String
  tailles       String
  colors        Json
  sizes         Json
  isNew         Boolean  @default(false)
  isBestSeller  Boolean  @default(false)
  tone          Int      @default(1)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([section])
  @@index([categoryId])
}
